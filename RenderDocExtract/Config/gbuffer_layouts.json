  "channel_schemas": {
    "SceneColor": {
      "description": "Lighting / SceneColor HDR output, usually accumulated lighting or emissive depending path.",
      "channels": {
        "R": {
          "name": "SceneColor.R",
          "meaning": "HDR linear scene color red, pre-exposed",
          "decode": "identity",
          "material_properties": []
        },
        "G": {
          "name": "SceneColor.G",
          "meaning": "HDR linear scene color green, pre-exposed",
          "decode": "identity",
          "material_properties": []
        },
        "B": {
          "name": "SceneColor.B",
          "meaning": "HDR linear scene color blue, pre-exposed",
          "decode": "identity",
          "material_properties": []
        },
        "A": {
          "name": "Unused_or_alpha",
          "meaning": "Usually unused for R11G11B10; present if RGBA16F fallback",
          "decode": "identity",
          "material_properties": []
        }
      }
    },
    "WorldNormal_PerObjectData": {
      "description": "GBufferA: encoded world normal plus per-object 2-bit data in default A2B10G10R10 layout.",
      "channels": {
        "R": {
          "name": "WorldNormal.X",
          "meaning": "Encoded world normal X",
          "decode": "encoded_normal_component",
          "formula": "decoded = encoded * 2 - 1",
          "material_properties": [
            "Normal"
          ]
        },
        "G": {
          "name": "WorldNormal.Y",
          "meaning": "Encoded world normal Y",
          "decode": "encoded_normal_component",
          "formula": "decoded = encoded * 2 - 1",
          "material_properties": [
            "Normal"
          ]
        },
        "B": {
          "name": "WorldNormal.Z",
          "meaning": "Encoded world normal Z",
          "decode": "encoded_normal_component",
          "formula": "decoded = encoded * 2 - 1",
          "material_properties": [
            "Normal"
          ]
        },
        "A": {
          "name": "PerObjectGBufferData",
          "meaning": "Packed per-object flags",
          "decode": "per_object_gbuffer_data_2bit",
          "packed_bits": {
            "0": "CastContactShadow",
            "1": "HasDynamicIndirectShadowCasterRepresentation"
          },
          "material_properties": []
        }
      }
    },
    "Metallic_Specular_Roughness_ShadingModel": {
      "description": "GBufferB: metallic/specular/roughness and packed shading model/selective output mask.",
      "channels": {
        "R": {
          "name": "Metallic",
          "meaning": "Metallic factor [0,1]",
          "decode": "identity",
          "material_properties": [
            "Metallic"
          ]
        },
        "G": {
          "name": "Specular",
          "meaning": "Specular factor [0,1], default dielectric F0 around 0.5",
          "decode": "identity",
          "material_properties": [
            "Specular"
          ]
        },
        "B": {
          "name": "Roughness",
          "meaning": "Roughness factor [0,1]",
          "decode": "identity",
          "material_properties": [
            "Roughness"
          ]
        },
        "A": {
          "name": "ShadingModelID_SelectiveOutputMask",
          "meaning": "Low 4 bits ShadingModelID, high 4 bits selective output flags",
          "decode": "gbuffer_b_alpha_packed",
          "packed_bits": {
            "0-3": "ShadingModelID",
            "4": "HAS_ANISOTROPY_MASK",
            "5": "SKIP_PRECSHADOW_MASK",
            "6": "ZERO_PRECSHADOW_MASK_or_IS_FIRST_PERSON_MASK",
            "7": "SKIP_VELOCITY_MASK"
          },
          "material_properties": [
            "ShadingModelID"
          ]
        }
      }
    },
    "BaseColor_AO_IndirectIrradiance": {
      "description": "GBufferC: base color plus AO/indirect irradiance in alpha. RGB is sRGB in default path.",
      "channels": {
        "R": {
          "name": "BaseColor.R",
          "meaning": "Base color red, sRGB-encoded in default RGBA8_sRGB",
          "decode": "srgb_to_linear_optional",
          "material_properties": [
            "BaseColor"
          ]
        },
        "G": {
          "name": "BaseColor.G",
          "meaning": "Base color green, sRGB-encoded in default RGBA8_sRGB",
          "decode": "srgb_to_linear_optional",
          "material_properties": [
            "BaseColor"
          ]
        },
        "B": {
          "name": "BaseColor.B",
          "meaning": "Base color blue, sRGB-encoded in default RGBA8_sRGB",
          "decode": "srgb_to_linear_optional",
          "material_properties": [
            "BaseColor"
          ]
        },
        "A": {
          "name": "IndirectIrradiance_x_AO_or_AO",
          "meaning": "Usually log2 encoded IndirectIrradiance * GBufferAO when ALLOW_STATIC_LIGHTING=1; otherwise AO or diffuse sample occlusion depending compile flags",
          "decode": "indirect_irradiance_log2_or_ao",
          "formula": "approx_luminance = exp2((encoded - 0.5) * 16) - exp2(-8); pre-exposure not removed",
          "material_properties": [
            "AO"
          ]
        }
      }
    },
    "CustomData": {
      "description": "GBufferD: custom data, interpretation depends on ShadingModelID from GBufferB.A.",
      "channels": {
        "R": {
          "name": "CustomData.R",
          "meaning": "DefaultLit/Unlit:0; Subsurface/Foliage/Cloth: sqrt(SubsurfaceColor.R); ClearCoat: ClearCoat; Hair: WorldNormalOct.X; Eye: SubsurfaceProfileID",
          "decode": "custom_data_by_shading_model",
          "material_properties": [
            "SubsurfaceColor"
          ]
        },
        "G": {
          "name": "CustomData.G",
          "meaning": "DefaultLit/Unlit:0; Subsurface/Foliage/Cloth: sqrt(SubsurfaceColor.G); ClearCoat: ClearCoatRoughness; Hair: WorldNormalOct.Y; Eye: IrisNormalOct.X delta",
          "decode": "custom_data_by_shading_model",
          "material_properties": [
            "SubsurfaceColor"
          ]
        },
        "B": {
          "name": "CustomData.B",
          "meaning": "DefaultLit/Unlit:0; Subsurface/Foliage/Cloth: sqrt(SubsurfaceColor.B); ClearCoat: BottomNormalOct.Y delta; Hair: Backlit; Eye: IrisNormalOct.Y delta",
          "decode": "custom_data_by_shading_model",
          "material_properties": [
            "SubsurfaceColor"
          ]
        },
        "A": {
          "name": "CustomData.A",
          "meaning": "DefaultLit/Unlit:0; Subsurface/Foliage: Opacity; Cloth: Cloth mask; Eye: 1-IrisMask; Hair:0",
          "decode": "custom_data_by_shading_model",
          "material_properties": [
            "Opacity"
          ]
        }
      },
      "shading_model_table": {
        "0": "Unlit: no custom data",
        "1": "DefaultLit: no custom data",
        "2": "Subsurface: sqrt(SubsurfaceColor.rgb), Opacity",
        "3": "PreintegratedSkin: sqrt(SubsurfaceColor.rgb), Opacity",
        "4": "ClearCoat: ClearCoat, ClearCoatRoughness, BottomNormal delta oct Y/X",
        "5": "SubsurfaceProfile: ProfileID in R, Opacity in A",
        "6": "TwoSidedFoliage: sqrt(SubsurfaceColor.rgb), Opacity",
        "7": "Hair: WorldNormal oct XY, Backlit, 0",
        "8": "Cloth: sqrt(SubsurfaceColor.rgb), Cloth mask",
        "9": "Eye: ProfileID, IrisNormal delta XY, 1-IrisMask"
      }
    },
    "PrecomputedShadowFactors": {
      "description": "GBufferE: static lighting precomputed shadow factors.",
      "channels": {
        "R": {
          "name": "PrecomputedShadowFactor0",
          "meaning": "Static shadow factor channel 0",
          "decode": "identity",
          "material_properties": []
        },
        "G": {
          "name": "PrecomputedShadowFactor1",
          "meaning": "Static shadow factor channel 1",
          "decode": "identity",
          "material_properties": []
        },
        "B": {
          "name": "PrecomputedShadowFactor2",
          "meaning": "Static shadow factor channel 2",
          "decode": "identity",
          "material_properties": []
        },
        "A": {
          "name": "PrecomputedShadowFactor3",
          "meaning": "Static shadow factor channel 3",
          "decode": "identity",
          "material_properties": []
        }
      }
    },
    "Velocity": {
      "description": "Velocity RT. Shader outputs float4; actual RT may store RG only or RGBA with depth delta packed into BA.",
      "channels": {
        "R": {
          "name": "Velocity.X",
          "meaning": "Encoded screen-space velocity X",
          "decode": "velocity_xy",
          "formula": "encoded = gamma(V.x) * 0.2495 + 32767/65535; gamma decode: x=(u*abs(u))*0.5 where u=(encoded-bias)/0.2495",
          "material_properties": [
            "Velocity"
          ]
        },
        "G": {
          "name": "Velocity.Y",
          "meaning": "Encoded screen-space velocity Y",
          "decode": "velocity_xy",
          "formula": "encoded = gamma(V.y) * 0.2495 + 32767/65535; gamma decode: y=(u*abs(u))*0.5 where u=(encoded-bias)/0.2495",
          "material_properties": [
            "Velocity"
          ]
        },
        "B": {
          "name": "DeviceZDelta_High16",
          "meaning": "For RGBA16_UNORM velocity-depth layout: high 16 bits of asuint(DeviceZDelta). Discarded in RG16 layouts.",
          "decode": "velocity_depth_high16",
          "material_properties": [
            "Velocity"
          ]
        },
        "A": {
          "name": "DeviceZDelta_Low16_AndFlags",
